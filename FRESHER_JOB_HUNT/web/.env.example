# Copy to .env.local for local development; set the same names in Vercel → Project → Settings → Environment Variables.

# Supabase (server only: never prefix these with NEXT_PUBLIC_)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (optional; spam protection on the signup form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Join links shown on the site
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_channel
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/your-invite-code
